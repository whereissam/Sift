{
  "name": "sift-extension",
  "description": "Sift browser extension — one-click capture to your Sift server",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.3.4",
    "vitest": "^3.0.0",
    "wxt": "0.20.27"
  }
}
